[Unit]
Description=Server AI Agent -- headless AI agent server (Telegram + transport for thin clients)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/server-ai-agent
ExecStart=%h/server-ai-agent/server-app/build/install/server-app/bin/server-app
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
